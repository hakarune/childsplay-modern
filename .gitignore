# ---------------------------------------------------------------------------
# Childsplay-Modern .gitignore
# Covers: Godot 4 and Debian build artifacts
# ---------------------------------------------------------------------------

# --- Godot 4 engine ---
# .godot/ holds the throwaway import cache and editor state.
.godot/
.import/
*.translation
# NOTE: *.import / *.uid files for committed assets (godot/assets/**, icon.svg)
# are intentionally tracked so a fresh clone opens without a full reimport.
# export_presets.cfg is also tracked (godot/export_presets.cfg) — CI and local
# builds share the same Linux/Windows/Web presets.
# Godot editor / mono / temp
.mono/
data_*/
*.tmp

# --- Godot exports / native builds ---
godot/build/
godot/bin/
*.pck
*.x86_64
*.exe
*.dmg
*.app

# --- Generic build / distribution output ---
build/
dist/
out/
*.log

# --- Debian packaging artifacts ---
*.deb
*.ddeb
*.buildinfo
*.changes
debian/.debhelper/
debian/files
debian/*.substvars
debian/*.debhelper
pkgroot/
deb-pkg/

# --- Legacy upstream sources (checked out locally, not tracked) ---
legacy-sources/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
